# Kopie als .env anlegen und ausfüllen. .env steht in .gitignore.

# Fredy-Zugang (für access: api)
FREDY_USERNAME=admin
FREDY_PASSWORD=

# Telegram (Phase 5)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SMTP für den Digest (Phase 5)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# immo-server (Phase 7)
# scripts/set_password.py [--mcp-token] setzt diese Werte
UI_PASSWORD_HASH=
SESSION_SECRET=
MCP_TOKEN=

# Nur Rückfallebene, falls die normale Claude-Anmeldung im unbeaufsichtigten Betrieb nicht hält
CLAUDE_CODE_OAUTH_TOKEN=
